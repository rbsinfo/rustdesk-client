# Instance configuration. Plain KEY=VALUE lines; this file is parsed, never executed.
# Nothing here is secret: all of it can be read from the client you distribute.

# Name shown to users. It is also the Windows executable and the macOS bundle name.
# Letters, digits, space, dot, dash and underscore; 40 characters at most.
APP_NAME=Remote Support

# Publisher shown in the Windows file properties and in the About page.
COMPANY=Example Org

# Reverse-DNS identifier of the macOS application.
BUNDLE_ID=org.example.remotesupport

# Your RustDesk server (hbbs). Add :port only when it is not 21116.
SERVER_HOST=rustdesk.example.com

# Public key of the server: the content of id_ed25519.pub.
SERVER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional. URL of the API server / web console (RustDesk Server Pro or a
# compatible console). Leave empty when you only run hbbs and hbbr.
API_URL=

# Optional. Opened by the "Website" link of the About page.
WEBSITE_URL=

# Optional but recommended: where the source of this client is published.
# The AGPL requires you to offer it to everyone who receives the client.
SOURCE_URL=

# Optional. Accent colour of the interface, as #RRGGBB.
ACCENT_COLOR=
